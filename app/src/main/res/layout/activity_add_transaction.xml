<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6"
    android:orientation="vertical">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#2E7D32"
        app:title="Thêm giao dịch"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Toggle Chọn Loại: Chi tiền / Thu tiền (Viền xám đậm rõ ràng) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleLoaiGiaoDich"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:checkedButton="@id/btnLoaiChi"
                app:selectionRequired="true"
                app:singleSelection="true"
                app:strokeColor="#555555"
                app:strokeWidth="1.5dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoaiChi"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="CHI TIỀN"
                    android:textColor="#F44336"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:strokeColor="#555555"
                    app:strokeWidth="1.5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoaiThu"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="THU TIỀN"
                    android:textColor="#4CAF50"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:strokeColor="#555555"
                    app:strokeWidth="1.5dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Ô nhập Số tiền -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Số tiền (VNĐ)"
                android:textColorHint="#444444"
                app:boxStrokeColor="#555555"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#2E7D32"
                app:prefixText="đ "
                app:prefixTextColor="#111111">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSoTien"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="#111111"
                    android:textColorHint="#666666"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Chọn Danh mục -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Chọn danh mục"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerDanhMuc"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_border_gray"
                android:paddingHorizontal="12dp" />

            <!-- Chọn Ngày giao dịch -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Ngày giao dịch"
                android:textColorHint="#444444"
                app:boxStrokeColor="#555555"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                app:endIconMode="custom"
                app:endIconTint="#2E7D32"
                app:hintTextColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNgayGiaoDich"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:textColor="#111111"
                    android:textColorHint="#666666"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ghi chú ngắn -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="Ghi chú (không bắt buộc)"
                android:textColorHint="#444444"
                app:boxStrokeColor="#555555"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGhiChu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="#111111"
                    android:textColorHint="#666666"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Nút Lưu giao dịch -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLuuGiaoDich"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#2E7D32"
                android:text="LƯU GIAO DỊCH"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>